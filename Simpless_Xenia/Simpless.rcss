.btBrowser
{
	decorator: image(btBrowser_default fill);
}
.btBrowser:checked
{
	decorator: image(btBrowser_checked fill);
}
.btBrowser:checked:active
{
	decorator: image(btBrowser_checked-active fill);
}
.btBrowser:checked:hover
{
	decorator: image(btBrowser_checked-hover fill);
}
.btBrowser:hover
{
	decorator: image(btBrowser_hover fill);
}
.knob
{
	frames: 84;
	spriteprefix: lbPlayParams_;
}
.knob1
{
	frames: 90;
	spriteprefix: kbMainUni_;
}
.knob2
{
	frames: 90;
	spriteprefix: kbMainBi_;
}
.knob3
{
	frames: 90;
	spriteprefix: kbMainKT_;
}
.knob4
{
	frames: 90;
	spriteprefix: kbWavetable_;
}
.knob5
{
	frames: 90;
	spriteprefix: kbRedUni_;
}
