body
{
	font-size: 28dp;
    font-family: Gabarito;
}
input.text
{
	background-color: #1c120c;
	border: 0dp transparent;
	color: #f5cd92;
	font-size: 28.000000dp;
	text-align: left;
}
scrollbarvertical sliderbar, scrollbarhorizontal sliderbar, splitter:active
{
	background-color: #a9672f;
}
tree
{
	background-color: #1c120c;
}
treenode
{
	color: #fbf1e4;
	font-size: 28.000000dp;
	text-align: left;
}
treenode:selected
{
	background-color: #8f4d25;
}


