.list, .grid, .pm-infopanel
{
	background-color: #1c120c;
}
.listentry, .gridentry
{
	color: #f5cd92;
	font-size: 28.000000dp;
	text-align: left;
}
.listentry:selected, .gridentry:selected
{
	background-color: #8f4d25;
}
.pm-hlayout
{
	background-color: #1c120c;
}
.pm-info-headline
{
	color: #eacbad;
	font-size: 32.000000dp;
}
.pm-info-name
{
	color: #e0a867;
	font-size: 64.000000dp;
}
.pm-info-text
{
	color: #e0a867;
	font-size: 32.000000dp;
}
.pm-status
{
	border: 0dp transparent;
	color: #f5cd92;
	font-size: 32.000000dp;
	text-align: left;
}
.pm-vlayout
{
	gap: 4dp;
}
.pm-count {
	font-weight: 700;
	color: #f5cd92;
}
.txt
{
	color: #fbf1e4;
	font-size: 24dp;
	font-weight: 400;
	text-align: left;
}
.txt1
{
	color: #fbf1e4;
	font-size: 34.000000dp;
	font-weight: bold;
	text-align: center;
}
.txt2
{
	color: #f5cd92;
	font-size: 40.000000dp;
	text-align: center;
	display: none;
}
